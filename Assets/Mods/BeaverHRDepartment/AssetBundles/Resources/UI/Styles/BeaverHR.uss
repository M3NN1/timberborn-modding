.bhr-panel {
    color: rgba(204, 204, 204, 1);
    font-size: 12px;
    padding: 9px 12px;
    margin: 1px;
    background-color: rgba(34, 54, 42, 1);
    border-radius: 2px;
}
.bhr-panel__header { 
    margin-bottom: 7px; 
}
.bhr-panel__title {
    font-size: 14px;
}
.bhr-worker-row {
    flex-direction: row;
    align-items: center;
    padding: 2px 4px;
    margin-bottom: 2px;
    background-color: rgba(21, 39, 34, 1);
    border-width: 1px;
    border-color: rgba(176, 152, 102, 1);
    border-radius: 2px;
}
.bhr-worker-label { 
    flex-grow: 1;
}
.bhr-remove-btn {
    font-size: 10px; 
    padding: 1px 4px;
    background-color: rgba(98, 83, 66, 1);
    border-radius: 2px; 
    color: rgba(204, 204, 204, 1);
}
.bhr-assign-btn {
    padding: 4px 8px;
    background-color: rgba(98, 83, 66, 1);
    border-width: 1px;
    border-color: rgba(176, 152, 102, 1);
    border-radius: 2px;
    color: rgba(204, 204, 204, 1);
}
.bhr-picker {
    max-height: 100px;
    margin-top: 2px;
    overflow: hidden;
}
.bhr-picker-button {
    padding: 3px 4px;
    margin-bottom: 2px; 
    background-color: rgba(21, 39, 34, 1);
    border-width: 1px;
    border-color: rgba(176, 152, 102, 1);
    border-radius: 2px;
}
